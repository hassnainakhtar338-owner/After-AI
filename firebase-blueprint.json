{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user workspace profile and preferences for After AI.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL.",
          "maxLength": 500
        },
        "preferredModel": {
          "type": "string",
          "description": "Default Gemini model selected in chat.",
          "enum": [
            "gemini-4-hydrogen",
            "gemini-4-carbon",
            "gemini-4-neon",
            "gemini-3.1-flash-lite"
          ]
        },
        "theme": {
          "type": "string",
          "description": "UI color theme preference.",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "preferredModel", "theme", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A multi-turn After AI conversation thread owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Chat document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Conversation title.",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "description": "Selected Gemini model for the chat.",
          "enum": [
            "gemini-4-hydrogen",
            "gemini-4-carbon",
            "gemini-4-neon",
            "gemini-3.1-flash-lite"
          ]
        },
        "systemInstruction": {
          "type": "string",
          "description": "Custom system instruction for the assistant persona.",
          "maxLength": 2000
        },
        "messageCount": {
          "type": "integer",
          "description": "Number of persisted messages in this chat."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "userId", "title", "model", "systemInstruction", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single user or assistant turn within a ChatSession.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "description": "Parent ChatSession ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Message author role.",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "description": "Markdown message body.",
          "minLength": 1,
          "maxLength": 60000
        },
        "model": {
          "type": "string",
          "description": "Gemini model identifier used for this turn.",
          "maxLength": 64
        },
        "thinkingUsed": {
          "type": "boolean",
          "description": "Whether high thinking mode was enabled."
        },
        "mapsLinks": {
          "type": "array",
          "description": "Bounded list of Google Maps grounding place references."
        },
        "attachmentLabel": {
          "type": "string",
          "description": "Lightweight metadata label for attached media.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "userId", "chatId", "role", "content", "model", "thinkingUsed", "createdAt"]
    },
    "ImageCreation": {
      "title": "ImageCreation",
      "description": "Metadata log of image generation and editing jobs in Image Studio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Creation document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "prompt": {
          "type": "string",
          "description": "Prompt used to generate or edit the image.",
          "minLength": 1,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "description": "Agnes AI image model identifier.",
          "enum": [
            "agnes-image-2.5-flash",
            "agnes-image-2.1-flash",
            "agnes-image-2.0-flash"
          ]
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio chosen for the output.",
          "enum": ["1:1", "3:4", "4:3", "9:16", "16:9", "1:4", "1:8", "4:1", "8:1"]
        },
        "imageSize": {
          "type": "string",
          "description": "Resolution preset chosen for the output.",
          "enum": ["1K", "2K", "4K"]
        },
        "mode": {
          "type": "string",
          "description": "Whether this job generated a new image or edited an input image.",
          "enum": ["generate", "edit"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "userId", "prompt", "model", "aspectRatio", "imageSize", "mode", "createdAt"]
    },
    "AgentArtifact": {
      "title": "AgentArtifact",
      "description": "Self-contained HTML app, website, or 2D game generated by After AI Agent.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Artifact document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Artifact title.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Build category.",
          "enum": ["auto", "app", "website", "game2d"]
        },
        "prompt": {
          "type": "string",
          "description": "User prompt for the build.",
          "minLength": 1,
          "maxLength": 2000
        },
        "summary": {
          "type": "string",
          "description": "Architectural summary from the agent.",
          "maxLength": 8000
        },
        "html": {
          "type": "string",
          "description": "Complete standalone HTML5 document.",
          "minLength": 1,
          "maxLength": 250000
        },
        "model": {
          "type": "string",
          "description": "Model identifier used for the build.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "userId", "title", "category", "prompt", "summary", "html", "model", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user workspace profile and model/theme preferences."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Owner-only conversation threads."
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a user's conversation thread."
    },
    "/users/{userId}/creations/{creationId}": {
      "schema": { "$ref": "#/entities/ImageCreation" },
      "description": "Owner-only log of Image Studio prompts and configurations."
    },
    "/users/{userId}/artifacts/{artifactId}": {
      "schema": { "$ref": "#/entities/AgentArtifact" },
      "description": "Owner-only Coding Agent builds (apps, websites, 2D games)."
    }
  }
}
